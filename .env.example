# -----------------------------------------------------------------------------
# Aera Market — Environment Variables
# Copy to .env.local for local development. Never commit real secrets.
# -----------------------------------------------------------------------------

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Database (Prisma / PostgreSQL) ---
# DATABASE_URL="postgresql://user:password@host:5432/aera_market?schema=public"
# DIRECT_URL="postgresql://user:password@host:5432/aera_market?schema=public"

# --- Authentication (Auth.js) ---
# AUTH_SECRET="generate-with: openssl rand -base64 32"
# AUTH_URL="http://localhost:3000"
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# --- Email (Resend) ---
# RESEND_API_KEY=""

# --- File Storage (Cloudflare R2) ---
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME="aera-market-files"
# R2_PUBLIC_URL="" # optional — private files only use signed URLs

# --- Payments (choose providers once verified) ---
# LEMONSQUEEZY_API_KEY=""
# LEMONSQUEEZY_WEBHOOK_SECRET=""
# SAFEPAY_API_KEY=""
# SAFEPAY_WEBHOOK_SECRET=""

# --- Observability ---
# SENTRY_DSN=""
