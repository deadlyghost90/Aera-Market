# =============================================================================
# Aera Market — environment template
# Copy to .env.local for local work. In Vercel, paste these into
# Project -> Settings -> Environment Variables (Production and Preview),
# then REDEPLOY - environment changes only apply to a new deployment.
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase Admin (server only) — from Firebase Console -> Service accounts
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=aera-s-store
FIREBASE_DATABASE_URL=https://aera-s-store-default-rtdb.europe-west1.firebasedatabase.app
FIREBASE_API_KEY=AIzaSyAAhQj4TS0TZ9RUelGJrq1YoTC-NBN9h_A

# Easiest: base64 of the whole service-account JSON.
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json"))
FIREBASE_SERVICE_ACCOUNT_B64=

# Alternative to the line above (harder: newlines must be escaped as \n):
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Safepay — the payment gateway in use (dashboard -> Developers / API)
# -----------------------------------------------------------------------------
SAFEPAY_PUBLIC_KEY=sec_71fb7e16-8286-414d-80ae-c879421990c4
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_ENVIRONMENT=sandbox
SAFEPAY_BASE_URL=https://sandbox.api.getsafepay.com
SAFEPAY_CHECKOUT_URL=https://sandbox.api.getsafepay.com/components

# Production values (switch both when you go live):
# SAFEPAY_ENVIRONMENT=production
# SAFEPAY_BASE_URL=https://api.getsafepay.com
# SAFEPAY_CHECKOUT_URL=https://www.getsafepay.com/components

# -----------------------------------------------------------------------------
# Backblaze B2 — private bucket for product files and previews
# -----------------------------------------------------------------------------
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003
B2_BUCKET_NAME=AeraStorage
B2_KEY_ID=0038419aba147b90000000001
B2_APPLICATION_KEY=

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Exact origin, no trailing slash. Must be https in production.
APP_ORIGIN=https://aeramarket99.vercel.app
PLATFORM_COMMISSION_PERCENT=40
PAYMENTS_ENABLED=true
SESSION_COOKIE_NAME=__Host-aera_session
SESSION_TTL_DAYS=5
